end)

-- ================= TAB 3: PLAYER & TOOLS =================
createButton(Tab3Container, "Bring Player / TP to Player", 0, function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame
            break
        end
    end
end)

-- ================= BACKGROUND LOOPS =================
RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")

    -- Noclip Loop
    if Config.Noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Aura Kill Baldi Loop
    if Config.AuraKill and root then
        local baldi = workspace:FindFirstChild("Baldi")
        if baldi and baldi:FindFirstChild("HumanoidRootPart") then
            if (root.Position - baldi.HumanoidRootPart.Position).Magnitude < 15 then
                pcall(function()
                    firetouchinterest(root, baldi.HumanoidRootPart, 0)
                    firetouchinterest(root, baldi.HumanoidRootPart, 1)
                end)
            end
        end
    end
end)

