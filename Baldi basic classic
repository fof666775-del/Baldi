-- ================= TAB 2: BALDI CONTROL =================
local baldiDeletedInstance = nil

createButton(Tab2Container, "Delete / Restore Baldi", 0, function()
    local baldi = workspace:FindFirstChild("Baldi") or workspace:FindFirstChild("Bully")
    if not Config.BaldiDeleted then
        if baldi then
            baldiDeletedInstance = baldi:Clone()
            baldi:Destroy()
            Config.BaldiDeleted = true
        end
    else
        if baldiDeletedInstance then
            baldiDeletedInstance.Parent = workspace
            Config.BaldiDeleted = false
        end
    end
end)

createToggle(Tab2Container, "Freeze Baldi", 45, function(state)
    Config.BaldiFrozen = state
    local baldi = workspace:FindFirstChild("Baldi")
    if baldi and baldi:FindFirstChild("HumanoidRootPart") then
        baldi.HumanoidRootPart.Anchored = state
    end
end)

createButton(Tab2Container, "Bring Baldi to Me", 90, function()
    local baldi = workspace:FindFirstChild("Baldi")
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if baldi and baldi:FindFirstChild("HumanoidRootPart") and root then
        baldi.HumanoidRootPart.CFrame = root.CFrame + (root.CFrame.LookVector * 5)
    end
end)

createToggle(Tab2Container, "Aura Kill Baldi", 135, function(state)
